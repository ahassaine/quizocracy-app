# Copy to .env (mode 600). Everything the service needs to run on any machine.
QZ_ENV=prod
QZ_MONGO_URL=mongodb://127.0.0.1:27017
QZ_DB=qz
QZ_PUBLIC_URL=https://quizocracy.com
QZ_MAIL_MODE=smtp
QZ_MAIL_HOST=localhost
QZ_MAIL_PORT=25
QZ_MAIL_FROM=Quizocracy <noreply@quizocracy.com>
QZ_INVITE_CODE=change-me
QZ_BETA_FAMILY_PLAN=1
QZ_TZ=Europe/London
